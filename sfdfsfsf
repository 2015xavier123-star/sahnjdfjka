local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local grabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
local setNetworkOwnerEvent = grabEvents:WaitForChild("SetNetworkOwner")
local destroyGrabLineEvent = grabEvents:WaitForChild("DestroyGrabLine")

local menuToys = ReplicatedStorage:WaitForChild("MenuToys")
local SpawnToyRF = menuToys:WaitForChild("SpawnToyRemoteFunction")
local DeleteToyRE = menuToys:WaitForChild("DestroyToy")

local Settings = {
	KillAll = false,
	IgnoreFriends = false,
}

local function getLocalRoot()
	local char = LocalPlayer.Character
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end

local function getLocalHum()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getInv()
	return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

local function getBlobman()
	local hum = getLocalHum()
	if hum and hum.Sit and hum.SeatPart and hum.SeatPart.Parent then
		if hum.SeatPart.Parent.Name == "CreatureBlobman" then
			return hum.SeatPart.Parent
		end
	end
	local inv = getInv()
	if inv then
		local v = inv:FindFirstChild("CreatureBlobman")
		if v and v:IsA("Model") and v:FindFirstChild("VehicleSeat") then
			return v
		end
	end
	return nil
end

local function isSittingOnBlobman()
	local hum = getLocalHum()
	return hum and hum.Sit and hum.SeatPart and hum.SeatPart.Parent and hum.SeatPart.Parent.Name == "CreatureBlobman"
end

local function spawnBlobman()
	local myRoot = getLocalRoot()
	if not myRoot then return nil end
	local existing = getBlobman()
	if existing then return existing end

	local inv = getInv()
	local spawned = nil
	local conn
	if inv then
		conn = inv.ChildAdded:Connect(function(toy)
			if toy.Name == "CreatureBlobman" and toy:IsA("Model") then
				spawned = toy
				conn:Disconnect()
			end
		end)
	end

	pcall(function()
		SpawnToyRF:InvokeServer("CreatureBlobman", myRoot.CFrame * CFrame.new(3, 0, 0), Vector3.zero)
	end)

	local t = tick()
	while not spawned and tick() - t < 3 do
		task.wait(0.05)
	end
	if conn then conn:Disconnect() end

	if spawned then
		spawned:WaitForChild("VehicleSeat", 2)
		return spawned
	end
	return getBlobman()
end

local function forceSitBlobman(blob)
	if not blob or not blob:FindFirstChild("VehicleSeat") then return false end
	local seat = blob.VehicleSeat
	local hum = getLocalHum()
	local root = getLocalRoot()
	if not hum or not root then return false end
	if hum.Sit and hum.SeatPart == seat then return true end

	root.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
	task.wait(0.05)
	pcall(function() seat:Sit(hum) end)
	task.wait(0.1)
	return isSittingOnBlobman()
end

local function blobKickAction(blob, hrp, side, action)
	local detector = blob:FindFirstChild(side .. "Detector")
	local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
	if not (detector and scriptObj) then return end
	local weld = detector:FindFirstChild(side .. "Weld")

	if action == "Default" then
		local remote = scriptObj:FindFirstChild("CreatureGrab")
		if remote then pcall(function() remote:FireServer(detector, hrp, weld) end) end
	elseif action == "Release" then
		local remote = scriptObj:FindFirstChild("CreatureRelease")
		if remote then pcall(function() remote:FireServer(weld, hrp) end) end
	elseif action == "Drop" then
		local remote = scriptObj:FindFirstChild("CreatureDrop")
		if remote then pcall(function() remote:FireServer(detector, hrp) end) end
	end
end

task.spawn(function()
	local blob = getBlobman() or spawnBlobman()
	if not blob or not blob:FindFirstChild("VehicleSeat") then
		warn("[KillAll] No Blobman available")
		return
	end

	if not isSittingOnBlobman() then
		if not forceSitBlobman(blob) then
			warn("[KillAll] Failed to sit on Blobman")
			return
		end
	end

	local MyBlob = getBlobman()
	if not MyBlob then return end

	local safePos = MyBlob.VehicleSeat.CFrame

	while Settings.KillAll do
		local mychar = LocalPlayer.Character
		local myHRP = mychar and mychar:FindFirstChild("HumanoidRootPart")
		local myhum = mychar and mychar:FindFirstChildOfClass("Humanoid")
		if not (myhum and myHRP) then
			task.wait(0.1)
			continue
		end

		if not isSittingOnBlobman() then
			local seat = MyBlob and MyBlob:FindFirstChild("VehicleSeat")
			if seat then
				myHRP.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
				task.wait(0.05)
				seat:Sit(myhum)
				task.wait(0.1)
			end
			if not isSittingOnBlobman() then
				task.wait(0.1)
				continue
			end
		end

		MyBlob = getBlobman()
		if not MyBlob then
			task.wait(0.2)
			continue
		end

		for _, ct in ipairs(Players:GetPlayers()) do
			if not Settings.KillAll then break end
			if ct == LocalPlayer then continue end

			if Settings.IgnoreFriends then
				local isFriend = false
				pcall(function() isFriend = LocalPlayer:IsFriendsWith(ct.UserId) end)
				if isFriend then continue end
			end

			local ctChar = ct.Character
			if not ctChar then continue end
			local hum = ctChar:FindFirstChildOfClass("Humanoid")
			local HRP = ctChar:FindFirstChild("HumanoidRootPart")
			if not (hum and HRP and hum.Health > 0) then continue end

			hum.BreakJointsOnDeath = false
			hum.WalkSpeed = 0
			hum.JumpPower = 0

			local LD = MyBlob:FindFirstChild("LeftDetector")
			local LW = LD and LD:FindFirstChild("LeftWeld")
			if not (LD and LW) then continue end

			local savedPos = myHRP.CFrame
			myHRP.CFrame = HRP.CFrame
			task.wait(0.03)

			if hum.SeatPart == nil then
				pcall(function()
					if hum.RigType ~= Enum.HumanoidRigType.R15 then
						hum.RigType = Enum.HumanoidRigType.R15
					end
					if hum.RigType ~= Enum.HumanoidRigType.R6 then
						hum.RigType = Enum.HumanoidRigType.R6
					end
					if hum.RigType ~= Enum.HumanoidRigType.R15 then
						hum.RigType = Enum.HumanoidRigType.R15
					end
				end)
			end
			task.wait()

			for i = 1, 4 do
				blobKickAction(MyBlob, HRP, "Left", "Default")
				task.wait(0.05)
				blobKickAction(MyBlob, HRP, "Left", "Release")
			end

			hum.Health = 0

			for i = 1, 4 do
				blobKickAction(MyBlob, HRP, "Left", "Default")
				task.wait(0.05)
				blobKickAction(MyBlob, HRP, "Left", "Release")
			end

			myHRP.CFrame = savedPos
		end

		MyBlob = getBlobman()
		if MyBlob and MyBlob:FindFirstChild("VehicleSeat") then
			MyBlob.VehicleSeat.CFrame = safePos
			for _, p in ipairs(MyBlob:GetDescendants()) do
				if p:IsA("BasePart") then
					p.AssemblyLinearVelocity = Vector3.zero
					p.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end

		task.wait(0.3)
	end
end)
